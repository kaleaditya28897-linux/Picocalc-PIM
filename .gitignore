# Build outputs
build/
*.elf
*.map
*.uf2
# ...except the published images, which are deliberate
!release/*.uf2
*.bin

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup

# Private data: host aliases, SSH keys, anything generated from ~/.ssh.
# The importer writes outside the repository by default and refuses to write
# inside a git work tree; these are a second line of defence.
hosts.cfg
ssh/
# holds a Tailscale auth key, which is a secret
tailscale.cfg
ts/
id_*
*.pub
!assets/**/*.pub
private/
pim_sim_root/

# The rest of what lives on the card. Wi-Fi passwords, the PIN's hash, pinned
# SSH host keys, and the PIM data itself - appointments, notes, journal. A copy
# of the card should never land in a checkout; if one does, it stays out.
wifi.cfg
lock.cfg
known_hosts
pim.dat
journal/
/PIM/
/sd/
*.log

# Local agent settings
.claude/
